# --- React app ko MySQL API se connect (Roman Urdu + English) ---
# Bina VITE_PHP_API_BASE ke app sirf browser localStorage use karti hai — DB se connect nahi.
#
# --- DB connected? (browser mein yeh link kholo — JSON aayega) ---
# Local XAMPP:
#   http://localhost/sheeza-beauty-portal-main/backend/api/index.php?resource=ping
# Hostinger (public_html/api):
#   https://whitesmoke-giraffe-103251.hostingersite.com/api/index.php?resource=ping
# Samajh: "connected": true aur "rowCounts" = DB theek | "connected": false = error/hint dekho
#
# Hostinger API base (slash NA):
# VITE_PHP_API_BASE=https://whitesmoke-giraffe-103251.hostingersite.com/api
#
# Local XAMPP API base:
# VITE_PHP_API_BASE=http://localhost/sheeza-beauty-portal-main/backend/api
#
# Production build (Hostinger static site) se pehle upar wali line apni .env mein set karein, phir npm run build.
#
# Sirf demo / localStorage:
# VITE_PHP_API_BASE=

VITE_PHP_API_BASE=https://whitesmoke-giraffe-103251.hostingersite.com/api

