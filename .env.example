# --- MySQL / XAMPP ke saath use karne ke liye (Roman Urdu + English) ---
# Bina is line ke React app sirf browser localStorage use karti hai — phpMyAdmin ka database
# website / admin panel se connect NAHI hota. Data DB mein insert ho sakta hai lekin UI par nahi dikhega.
#
# Backend folder ko htdocs mein copy karein, phir yahan woh URL likhein jahan api/index.php open ho
# (last mein slash NA ho). Example:
# VITE_PHP_API_BASE=http://localhost/sheeza-salon-api/api
#
# Test: browser mein kholein → http://localhost/sheeza-salon-api/api/index.php?resource=ping
# Agar "rowCounts" mein categories/services > 0 hon to DB theek hai; phir upar wali env line zaroor set karein.
#
# Chhor dein khali agar sirf demo / localStorage chahiye:
VITE_PHP_API_BASE=
